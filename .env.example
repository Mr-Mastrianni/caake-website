# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Who is an admin: comma-separated, must be verified Clerk emails. Empty = nobody. ---
ADMIN_EMAILS=you@caake.org

# --- Postgres (Neon, via Vercel Marketplace). Tables are created automatically. ---
DATABASE_URL=postgresql://...

# --- Agents ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional: send approved emails (Resend). Without these, approving just marks it approved. ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=C.A.A.K.E. <hello@caake.org>
# EMAIL_REPLY_TO=mastrianni@caake.org

